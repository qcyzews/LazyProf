FROM python:3.10-slim

WORKDIR /code

# Instalujemy zależności systemu operacyjnego (jeśli PyMuPDF/Poppler ich wymagają)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    python3-pip \
    python3-cffi \
    python3-brotli \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz-subset0 \
    libjpeg-dev \
    libopenjp2-7-dev \
    libffi-dev \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Kopiujemy plik wymagań i instalujemy biblioteki
COPY requirements.txt /code/requirements.txt
RUN pip install --no-cache-dir --upgrade -r /code/requirements.txt

# Kopiujemy całą resztę kodu backendu
COPY . /code

# Uruchamiamy czyste FastAPI na porcie 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]