FROM python:3.10-slim

WORKDIR /code

# Instalujemy zależności systemu operacyjnego (jeśli PyMuPDF/Poppler ich wymagają)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Kopiujemy plik wymagań i instalujemy biblioteki
COPY requirements.txt /code/requirements.txt
RUN pip install --no-cache-dir --upgrade -r /code/requirements.txt

# Kopiujemy całą resztę kodu backendu
COPY . /code

# Uruchamiamy czyste FastAPI na porcie 7860
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860"]